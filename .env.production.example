# ============================================================================
# YieldPoint — Production Environment Template
# Copy to .env on the production host and fill in all values.
#
# SECURITY: This file must NEVER be committed with real values.
# All secrets should come from a secrets manager (Vault, AWS SSM, etc.)
# ============================================================================

# ── Required Secrets ───────────────────────────────────────────────────────
# JWT signing secret — min 32 chars, cryptographically random
# Generate: openssl rand -base64 48
JWT_SECRET=

# PostgreSQL credentials — use a strong, unique password
POSTGRES_USER=yieldpoint
POSTGRES_PASSWORD=

# Object storage (AWS S3 or compatible)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=yieldpoint
S3_REGION=us-east-1
# S3_ENDPOINT=        # Only set for non-AWS S3-compatible stores
# S3_FORCE_PATH_STYLE=false

# ── Network ────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://app.yieldpoint.io
POSTGRES_DB=yieldpoint

# ── Database URLs ──────────────────────────────────────────────────────────
# Production should use sslmode=require or sslmode=verify-full
DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/yieldpoint?sslmode=require

# Per-service database URLs
FARM_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/farm_service?sslmode=require
FIELD_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/field_service?sslmode=require
CROP_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/crop_service?sslmode=require
SENSOR_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/sensor_service?sslmode=require
IRRIGATION_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/irrigation_service?sslmode=require
SOIL_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/soil_service?sslmode=require
YIELD_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/yield_service?sslmode=require
PEST_PREDICTION_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/pest_prediction_service?sslmode=require
PLANT_DIAGNOSIS_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/plant_diagnosis_service?sslmode=require
SATELLITE_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/satellite_service?sslmode=require
TRACEABILITY_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/traceability_service?sslmode=require
COMMERCE_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/commerce_service?sslmode=require
AUTH_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/auth_service?sslmode=require
SATELLITE_INGESTION_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/satellite_ingestion_service?sslmode=require
SATELLITE_PROCESSING_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/satellite_processing_service?sslmode=require
SATELLITE_ANALYTICS_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/satellite_analytics_service?sslmode=require
SATELLITE_TILE_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/satellite_tile_service?sslmode=require
VEGETATION_INDEX_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/vegetation_index_service?sslmode=require
TASK_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/task_service?sslmode=require
AGRONOMY_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/agronomy_service?sslmode=require

# ── Feature Flags ──────────────────────────────────────────────────────────
# GRPC_PLAINTEXT must NOT be set in production (TLS is the default)
# GRPC_PLAINTEXT is intentionally absent here

# ── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BROKER=<kafka-host>:9092
