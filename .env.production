# ============================================================================
# YieldPoint — Production Environment Template
# Copy to .env on the production host and fill in all values.
#
# SECURITY: This file must NEVER be committed with real values.
# All secrets should come from a secrets manager (Vault, AWS SSM, etc.)
# ============================================================================

# ── Required Secrets ───────────────────────────────────────────────────────
# JWT signing secret — min 32 chars, cryptographically random
# Generate: openssl rand -base64 48
JWT_SECRET=

# PostgreSQL credentials — use a strong, unique password
POSTGRES_USER=yieldpoint
POSTGRES_PASSWORD=

# Object storage (AWS S3 or compatible)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=yieldpoint
S3_REGION=us-east-1
# S3_ENDPOINT=        # Only set for non-AWS S3-compatible stores
# S3_FORCE_PATH_STYLE=false

# ── Network ────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://app.yieldpoint.io
POSTGRES_DB=yieldpoint

# ── Database URLs ──────────────────────────────────────────────────────────
# Production should use sslmode=require or sslmode=verify-full
DATABASE_URL=postgres://yieldpoint:<password>@<host>:5432/yieldpoint?sslmode=require

# ── Feature Flags ──────────────────────────────────────────────────────────
# GRPC_PLAINTEXT must NOT be set in production (TLS is the default)
# GRPC_PLAINTEXT is intentionally absent here

# ── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BROKER=<kafka-host>:9092
