# Dart and Flutter build artifacts.
#
# None of this was ignored, so `flutter pub get` and `build_runner` left a
# working tree full of untracked noise and the real changes were hard to see.
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
.pub-cache/
.pub/

# Generated by build_runner (drift, freezed, json_serializable). Produced from
# the sources next to them by `dart run build_runner build`, and none of it is
# committed today, so ignoring it matches how the repo already works.
*.g.dart
*.freezed.dart
*.mocks.dart

# Generated protobuf Dart is the exception: it IS committed, and CI's
# proto-check-dart job fails when it drifts from the .proto files.
!packages/flutter_proto/lib/src/generated/**

# Local toolchain paths, which differ per machine.
android/local.properties
android/.gradle/
android/app/src/main/java/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Pods/
ios/.symlinks/
**/android/local.properties
**/android/.gradle/
**/android/app/src/main/java/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh

# Coverage output.
coverage/
