{
	admin off
	auto_https off
}

:{$GATEWAY_PORT:8080} {
	log {
		output stdout
		format json
		level INFO
	}

	# ── Response compression ───────────────────────────────────────────
	#
	# Most of what this gateway returns is JSON or Connect envelopes, which
	# compress to a fraction of their size — and the farmers using it are often
	# on a rural mobile connection where bytes cost time, not just bandwidth.
	#
	# zstd is offered first for clients that take it and gzip for everything
	# else. Caddy skips already-compressed types (images, video) on its own, so
	# there is nothing to exclude here: re-compressing a JPEG spends CPU to make
	# the file slightly larger.
	encode zstd gzip

	# ── Security headers ───────────────────────────────────────────────
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# ── CORS ───────────────────────────────────────────────────────────
	header {
		Access-Control-Allow-Origin  {$CORS_ORIGIN:http://localhost:5173}
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Content-Type, Connect-Protocol-Version, Connect-Timeout-Ms, Grpc-Timeout, X-Grpc-Web, X-User-Agent, X-Tenant-ID"
		Access-Control-Expose-Headers "Grpc-Status, Grpc-Message, Grpc-Status-Details-Bin"
		Access-Control-Max-Age 86400
	}

	@options method OPTIONS
	handle @options {
		respond 204
	}

	# ── Request body size limit (10 MB default) ────────────────────────
	request_body {
		max_size 10MB
	}

	# ── Health / readiness probes ──────────────────────────────────────
	handle /health {
		respond `{"status":"ok","service":"api-gateway"}` 200
	}

	handle /ready {
		reverse_proxy farm-service:8080 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}
	}

	# ── Auth endpoints (tighter body limit) ────────────────────────────
	handle /auth/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy auth-service:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 10s
			}
		}
	}

	# ── Real-time transport ────────────────────────────────────────────
	#
	# The WebSocket hub and SSE broker had no gateway route at all, so a
	# browser that connected got the catch-all 404 below however correct the
	# server was.
	#
	# Both are long-lived and must not be cut off by the timeouts that suit a
	# unary RPC: a WebSocket stays open for the length of a field visit and an
	# SSE stream until the tab closes. `flush_interval -1` disables response
	# buffering, without which SSE events sit in Caddy's buffer until enough
	# accumulate — which for an alert stream is indefinitely.
	handle /ws {
		reverse_proxy monolith:8080 {
			transport http {
				dial_timeout 5s
			}
		}
	}

	handle /events {
		reverse_proxy monolith:8080 {
			flush_interval -1
			transport http {
				dial_timeout 5s
			}
		}
	}

	# ── ConnectRPC service routing ─────────────────────────────────────

	handle /agriculture.farm.v1.FarmService/* {
		reverse_proxy farm-service:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}
	}

	handle /agriculture.field.v1.FieldService/* {
		reverse_proxy field-service:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}
	}

	handle /agriculture.crop.v1.CropService/* {
		reverse_proxy crop-service:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}
	}

	handle /agriculture.sensor.v1.SensorService/* {
		reverse_proxy sensor-service:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}
	}

	handle /agriculture.irrigation.v1.IrrigationService/* {
