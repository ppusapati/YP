// YieldPoint Dev Container — Go 1.25 + Rust 1.82 + Node 20 + Protobuf
// Start with: "Dev Containers: Reopen in Container" in VS Code
{
  "name": "YieldPoint Platform",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.devcontainer.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/YP",

  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.25"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.82"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers-extra/features/buf:1": {},
    "ghcr.io/devcontainers-extra/features/protoc:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "rust-lang.rust-analyzer",
        "zxh404.vscode-proto3",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "go.lintTool": "golangci-lint",
        "rust-analyzer.check.command": "clippy",
        "[go]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "golang.go"
        },
        "[rust]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "[proto3]": {
          "editor.formatOnSave": true
        }
      }
    }
  },

  "forwardPorts": [
    5432,
    9092,
    8080,
    50051,
    3001,
    9091
  ],
  "portsAttributes": {
    "5432":  { "label": "PostgreSQL",  "onAutoForward": "silent" },
    "9092":  { "label": "Kafka",       "onAutoForward": "silent" },
    "8080":  { "label": "API Gateway", "onAutoForward": "notify" },
    "50051": { "label": "AI Gateway (gRPC)", "onAutoForward": "silent" },
    "3001":  { "label": "Grafana",     "onAutoForward": "notify" },
    "9091":  { "label": "Prometheus",  "onAutoForward": "silent" }
  },

  "postCreateCommand": "go mod download && cd ai-gateway && cargo fetch",

  "remoteUser": "vscode"
}
