# ============================================================================
# YieldPoint — Local Development Environment Variables
# Copy to .env and adjust as needed: cp .env.example .env
# ============================================================================

# ── Shared ──────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-me-in-production
KAFKA_BROKER=kafka:9092

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=yieldpoint
POSTGRES_PASSWORD=yieldpoint
POSTGRES_DB=yieldpoint

# ── Service database URLs ───────────────────────────────────────────────────
FARM_SERVICE_DATABASE_URL=postgres://yieldpoint:yieldpoint@postgres:5432/farm_service?sslmode=disable
FIELD_SERVICE_DATABASE_URL=postgres://yieldpoint:yieldpoint@postgres:5432/field_service?sslmode=disable
CROP_SERVICE_DATABASE_URL=postgres://yieldpoint:yieldpoint@postgres:5432/crop_service?sslmode=disable
SENSOR_SERVICE_DATABASE_URL=postgres://yieldpoint:yieldpoint@postgres:5432/sensor_service?sslmode=disable
IRRIGATION_SERVICE_DATABASE_URL=postgres://yieldpoint:yieldpoint@postgres:5432/irrigation_service?sslmode=disable
SOIL_SERVICE_DATABASE_URL=postgres://yieldpoint:yieldpoint@postgres:5432/soil_service?sslmode=disable
YIELD_SERVICE_DATABASE_URL=postgres://yieldpoint:yieldpoint@postgres:5432/yield_service?sslmode=disable
PEST_PREDICTION_SERVICE_DATABASE_URL=postgres://yieldpoint:yieldpoint@postgres:5432/pest_prediction_service?sslmode=disable
PLANT_DIAGNOSIS_SERVICE_DATABASE_URL=postgres://yieldpoint:yieldpoint@postgres:5432/plant_diagnosis_service?sslmode=disable
SATELLITE_SERVICE_DATABASE_URL=postgres://yieldpoint:yieldpoint@postgres:5432/satellite_service?sslmode=disable
TRACEABILITY_SERVICE_DATABASE_URL=postgres://yieldpoint:yieldpoint@postgres:5432/traceability_service?sslmode=disable
