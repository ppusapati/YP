# ============================================================================
# YieldPoint — Local Development Environment Variables
# Copy to .env and adjust as needed: cp .env.example .env
#
# SECURITY: Never commit .env to version control.
# Generate secrets with: openssl rand -base64 48
# ============================================================================

# ── Required Secrets ───────────────────────────────────────────────────────
# JWT signing secret (min 32 characters, use a cryptographically random value)
JWT_SECRET=

# PostgreSQL credentials
POSTGRES_USER=yieldpoint
POSTGRES_PASSWORD=

# Object storage (MinIO locally, S3 in production)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Shared ─────────────────────────────────────────────────────────────────
KAFKA_BROKER=kafka:9092
POSTGRES_DB=yieldpoint
CORS_ORIGIN=http://localhost:5173

# ── Service database URLs ──────────────────────────────────────────────────
# Replace <password> with your POSTGRES_PASSWORD value.
FARM_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/farm_service?sslmode=disable
FIELD_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/field_service?sslmode=disable
CROP_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/crop_service?sslmode=disable
SENSOR_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/sensor_service?sslmode=disable
IRRIGATION_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/irrigation_service?sslmode=disable
SOIL_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/soil_service?sslmode=disable
YIELD_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/yield_service?sslmode=disable
PEST_PREDICTION_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/pest_prediction_service?sslmode=disable
PLANT_DIAGNOSIS_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/plant_diagnosis_service?sslmode=disable
SATELLITE_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/satellite_service?sslmode=disable
TRACEABILITY_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/traceability_service?sslmode=disable
COMMERCE_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/commerce_service?sslmode=disable
AUTH_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/auth_service?sslmode=disable
TASK_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/task_service?sslmode=disable
AGRONOMY_SERVICE_DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/agronomy_service?sslmode=disable

# Monolith mode (single-binary)
DATABASE_URL=postgres://yieldpoint:<password>@postgres:5432/yieldpoint?sslmode=disable
