# ============================================================================
# YieldPoint — Local Development Environment Variables
# Copy to .env and adjust as needed: cp .env.example .env
#
# SECURITY: Never commit .env to version control.
# Generate secrets with: openssl rand -base64 48
# ============================================================================

# ── Required Secrets ───────────────────────────────────────────────────────
# JWT signing secret (min 32 characters, use a cryptographically random value)
JWT_SECRET=

# PostgreSQL superuser, used to create the databases and roles and by nothing
# else at runtime.
POSTGRES_USER=yieldpoint
POSTGRES_PASSWORD=

# The three roles services actually connect with. Created on first start by
# scripts/init-databases.sh.
#
# Splitting them is what makes row-level security do anything: a superuser
# bypasses RLS entirely, so while every service connected as one, the policies
# had never run — not in development, not in CI. yp_app is deliberately not a
# superuser so that they apply to it.
#
#   yp_migrator  owns the schema; the only role that runs DDL
#   yp_app       DML only, subject to RLS; the request path
#   yp_system    DML with BYPASSRLS, for the two jobs that read across tenants
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
DB_SYSTEM_PASSWORD=

# Object storage (MinIO locally, S3 in production)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Shared ─────────────────────────────────────────────────────────────────
KAFKA_BROKER=kafka:9092
POSTGRES_DB=yieldpoint
CORS_ORIGIN=http://localhost:5173

# ── Service database URLs ──────────────────────────────────────────────────
# Not listed, deliberately. Every service's DSN has a working default in
# docker-compose.yml, built from the role passwords above — so this section
# used to be twenty-one hand-maintained lines that had gone eight services
# stale, all of them naming the superuser.
#
# Override one only when you need to point a service somewhere else, e.g.
#   IRRIGATION_SERVICE_DATABASE_URL=postgres://yp_app:...@otherhost:5432/irrigation_service?sslmode=disable
# There is a _MIGRATOR variant of each for the DDL role, and alert-service and
# irrigation-service each take a _SYSTEM one for the work that reads across
# every tenant.

# ── Offline development ────────────────────────────────────────────────────
# Uncomment these to route every external API call to the local mockserver,
# so the platform runs with no network access, no API keys, and nobody else's
# rate limit. Start it with:  docker compose --profile offline up
#
# Left commented, the adapters call the real public APIs.
#
# OPEN_METEO_FORECAST_URL=http://mockserver:8199/v1/forecast
# OPEN_METEO_ARCHIVE_URL=http://mockserver:8199/v1/archive
# OPENWEATHER_BASE_URL=http://mockserver:8199/data/3.0/onecall
# OPENWEATHER_API_KEY=mock
#
# The ai-gateway reads its vision provider from a TOML file rather than the
# environment, so point it at the bundled offline config as well:
# AI_GATEWAY_CONFIG=/app/configs/ai-gateway.offline.toml
